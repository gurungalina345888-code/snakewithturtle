
import turtle as t
import random 
screen = t.Screen()
screen.title("snake game")
screen.setup(height=800, width=900)
t.tracer(0, 0)
p = t.Turtle()
p.speed(0)
p.hideturtle()
p.penup()

p.pensize(4)
p.color("black")
p.begin_fill()
p.penup()
p.fillcolor("light green")
p.goto(-440, -390)
p.pendown()
p.goto(440, -390)
p.goto(440, 390)
p.goto(-440, 390)
p.goto(-440, -390)
p.penup()
p.end_fill()
p.goto(0, 350)
p.write("SNAKE GAME", align="center",
        font=("Arial", 30, "bold"))
p.pensize(1)

s = t.Turtle()
s.hideturtle()
s.pensize(1)
s.penup()

go = t.Turtle()
go.penup()
go.hideturtle()
f = t.Turtle()
f.hideturtle()
x = 0
y = 0
score = 0 
is_collision = False
foodstep = 100
fo = t.Turtle()
head = t.Turtle()
head.penup()
head.color("black")
head.speed(0)
head.shape("square")
def hea():
    head.goto(x, y)
    head.setheading(0)
segments = []
def add_segment():
    segment = t.Turtle()
    segment.color("yellow")
    segment.speed(0)
    segment.shape("square")
    segment.penup()
    if len(segments) == 0:
        segment.goto(x-20, y)
    else:
        segment.goto(segments[-1].xcor()-20, segments[-1].ycor())
    
    segments.append(segment)
add_segment()
def move_segments():
    for i in range(len(segments)-1, 0, -1):
        segments[i].goto(segments[i-1].xcor(), segments[i-1].ycor())
    if len(segments) > 0:
        segments[0].goto(head.xcor(), head.ycor())
def updpoints():
    global score, foodstep
    fo.clear()
    fo.hideturtle()
    fo.penup()
    fo.goto(350, 300)
    fo.write(f"points: {score}",  align="right", font=("Arial", 20, "bold"))
    fo.goto(350, 330)
    fo.write(f"food moving in {foodstep}steps", align="right", font=("Arial", 20, "bold"))


direction = "right"
def up():
    global direction
    if direction != "down":
        direction = "up"
def down():
    global direction
    if direction != "up":
        direction = "down"
def left():
    global direction
    if direction != "right":
        direction = "left"
def right():
    global direction
    if direction != "left":
        direction = "right"
def collision():
    global x, y
    global is_collision
    if x <= -400 or x >= 400 or y <= -400 or y >= 400:
        is_collision = True
        s.goto(0, 0)
        go.goto(0, 0)
        go.write("game over. press space to restart.", align="center", font=("arial", 20, "bold"))
    for segment in segments:
        if head.distance(segment) < 10:
            go.goto(0, 0)
            go.write("game over. press space to restart.", align="center", font=("arial", 20, "bold"))
            is_collision = True
    s.hideturtle()
    s.penup()
    f.penup()
def res():
    global x, y
    global is_collision
    if is_collision == True:
        is_collision = False   
        go.reset()
        go.hideturtle()
        x = 0
        y = 0
fx = 0
fy = 0
def food():
    global fx, fy
    fx = random.randint(-400, 400)
    fy = random.randint(-350, 350)
    f.clear()
    f.penup()
    f.goto(fx, fy)
    f.shape("circle")
    f.color("red")
    f.showturtle()
def eat():
    global score
    global x, y, fx, fy
    if 0 <= abs(x - fx) <= 10 and 0 <= abs(y - fy) <= 10:
        score+=10
        food()
        add_segment()
def gameloop():
    global x, y
    global is_collision, foodstep
    if is_collision == False:
        move_segments()
        
       
        if direction == "up":
            y+=20
        elif direction == "down":
            y-=20
        elif direction == "left":
            x-=20
        elif direction == "right":
            x+=20
        if foodstep <= 0:
            food()
            foodstep = 100
        foodstep -= 1
        updpoints()
        hea()
        collision()
        eat()
    t.update()
    screen.ontimer(gameloop, 120)
food()




# Keyboard controls
screen.onkey(up, "w")
screen.onkey(down, "s")
screen.onkey(left, "a")
screen.onkey(right, "d")
screen.onkey(res, "space")
screen.listen()

gameloop()

t.mainloop()
